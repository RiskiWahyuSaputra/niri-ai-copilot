# Contoh konfigurasi environment — JANGAN commit API key asli.
#
# Salin ke .env (untuk development) atau export di shell profile Anda:
#   cp .env.example .env
#
# Aplikasi membaca variabel ini dari environment proses.

# API key Groq (wajib untuk fitur AI). Buat di https://console.groq.com/keys
GROQ_API_KEY=

# Opsional: override lokasi binary whisper.cpp (default: cari "whisper-cli" di PATH)
NIRI_AI_COPILOT_WHISPER_CLI=

# Opsional: override path model GGML/GGUF whisper (default: dari config.toml)
NIRI_AI_COPILOT_WHISPER_MODEL=

# Opsional: override lokasi config file
NIRI_AI_COPILOT_CONFIG_DIR=
